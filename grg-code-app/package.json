{
  "name": "grg-app",
  "productName": "GrgApp",
  "version": "1.0.0",
  "description": "GrgApp — the privacy-first Grg AI on your desktop: chat, specialist agents for every field, on-device privacy, and a built-in agent that works on your files.",
  "author": "Monescu Teodor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.grg.app",
    "productName": "GrgApp",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*", "knowledge/**/*", "templates/**/*"],
    "win": {
      "target": "portable",
      "artifactName": "GrgApp-win-x64-v41.exe",
      "icon": "renderer/icon.ico"
    },
    "portable": { "artifactName": "GrgApp-win-x64-v41.exe", "unicode": true }
  }
}
