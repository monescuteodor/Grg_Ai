{
  "name": "chrome-extension",
  "description": "Manifest V3 browser extension: popup + content script + background worker.",
  "run": [],
  "files": [
    {
      "path": "manifest.json",
      "content": "{\n  \"manifest_version\": 3,\n  \"name\": \"My Extension\",\n  \"version\": \"1.0.0\",\n  \"action\": {\n    \"default_popup\": \"popup.html\"\n  },\n  \"background\": {\n    \"service_worker\": \"bg.js\"\n  },\n  \"content_scripts\": [\n    {\n      \"matches\": [\n        \"<all_urls>\"\n      ],\n      \"js\": [\n        \"content.js\"\n      ]\n    }\n  ],\n  \"permissions\": [\n    \"storage\",\n    \"activeTab\",\n    \"scripting\"\n  ]\n}"
    },
    {
      "path": "popup.html",
      "content": "<!doctype html><html><head><meta charset='utf-8'><style>body{width:220px;font-family:system-ui;padding:12px}button{width:100%;padding:8px}</style></head><body><h3>My Extension</h3><button id='go'>Highlight page</button><script src='popup.js'></script></body></html>\n"
    },
    {
      "path": "popup.js",
      "content": "document.getElementById('go').addEventListener('click', async ()=>{\n  const [tab] = await chrome.tabs.query({active:true,currentWindow:true})\n  chrome.scripting.executeScript({ target:{tabId:tab.id}, func:()=>{ document.body.style.outline='4px solid #6d28d9' } })\n})\n"
    },
    {
      "path": "content.js",
      "content": "console.log('content script loaded on', location.href)\n"
    },
    {
      "path": "bg.js",
      "content": "chrome.runtime.onInstalled.addListener(()=> console.log('extension installed'))\n"
    }
  ]
}