{
  "name": "static-landing",
  "description": "Zero-build responsive landing page (HTML + CSS + a little JS). Open index.html.",
  "run": [],
  "files": [
    {
      "path": "index.html",
      "content": "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Landing</title><link rel='stylesheet' href='style.css'></head><body>\n<header><nav><b>Brand</b><a href='#cta'>Get started</a></nav></header>\n<main><section class='hero'><h1>Build something great</h1><p>A clean starting point for your product.</p><a id='cta' class='btn' href='#'>Try it free</a></section></main>\n<footer><small>&copy; 2026 Brand</small></footer>\n<script src='app.js'></script></body></html>\n"
    },
    {
      "path": "style.css",
      "content": ":root{--a:#6d28d9}*{box-sizing:border-box;margin:0}body{font-family:system-ui,sans-serif;color:#111}nav{display:flex;justify-content:space-between;align-items:center;padding:16px 24px}a{color:var(--a);text-decoration:none}.hero{max-width:720px;margin:12vh auto;text-align:center;padding:0 20px}h1{font-size:clamp(28px,6vw,52px);margin-bottom:16px}.btn{display:inline-block;margin-top:20px;background:var(--a);color:#fff;padding:12px 22px;border-radius:10px}footer{text-align:center;padding:40px;color:#666}\n"
    },
    {
      "path": "app.js",
      "content": "document.querySelector('.btn').addEventListener('click', e=>{ e.preventDefault(); alert('Thanks!') })\n"
    }
  ]
}