# Grg AI backend — environment variables
# Copy to `.env` (which is gitignored) and fill in your own values.
# The .env lives only on the server (e.g. /home/pi/GrgAI/.env) — never commit real keys.

# ── LLM providers ──
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Stripe (payments) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=

# ── App ──
FRONTEND_URL=https://grg-ai.com
