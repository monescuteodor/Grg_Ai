rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The user's billing/account doc. The client may READ its own, but NEVER write it —
    // only the server (firebase-admin) writes billing fields, and the admin SDK bypasses
    // these rules. This is what keeps wallet_eur / premium_credits / plan tamper-proof.
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Chat history — written directly from the browser.
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Consent / preferences — written directly from the browser.
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Top-up idempotency markers — server-only.
      match /topups/{sessionId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Everything else (e.g. the apikeys collection) is denied by default and reachable
    // only via the server (admin SDK).
  }
}
